# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore Terraform backup files
terraform.tfstate.backup

# Ignore .terraform directory (contains provider plugins and modules)
.terraform/

# Ignore variable files that might contain sensitive information
*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform lock file (provider versions)
.terraform.lock.*


